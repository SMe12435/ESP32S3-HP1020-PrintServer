[Unit]
Description=HP 1020 Cloud Print Server
After=network.target

[Service]
Type=notify
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ESP32S3-HP1020-PrintServer/server
EnvironmentFile=/home/ubuntu/ESP32S3-HP1020-PrintServer/server/.env
ExecStart=/usr/local/bin/gunicorn \
    --worker-class gevent \
    --workers 1 \
    --bind 0.0.0.0:5000 \
    --timeout 120 \
    app:app
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
